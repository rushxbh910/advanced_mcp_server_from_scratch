# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to set the Postgres password.
POSTGRES_PASSWORD=changeme

# Full connection string — in docker-compose this is built automatically from
# the services block. Set this directly when running outside Docker.
DATABASE_URL=postgresql://notesuser:changeme@localhost:5432/notesdb

# ── Stytch Auth ───────────────────────────────────────────────────────────────
# Find these in your Stytch dashboard → API Keys
STYTCH_DOMAIN=https://test.stytch.com/v1/projects/project-test-xxxx
STYTCH_PROJECT_ID=project-test-xxxx

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "false" for local development without Stytch configured
AUTH_ENABLED=true

# Publicly reachable URL of this server (used by the OAuth metadata endpoint)
BASE_URL=https://your-server.example.com

# Comma-separated list of allowed CORS origins. Leave empty to allow all.
ALLOWED_ORIGINS=https://your-frontend.example.com

PORT=8000
